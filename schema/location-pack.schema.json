{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worksoft.local/schemas/location-pack.json",
  "title": "Worksoft Location Pack",
  "type": "object",
  "required": ["id", "iso2", "code", "version", "default_locale", "country", "states"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]{2,32}$" },
    "iso2": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "code": { "type": "string", "minLength": 2, "maxLength": 10 },
    "version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "default_locale": { "type": "string", "minLength": 2, "maxLength": 10 },
    "country": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "object", "additionalProperties": { "type": "string" } },
        "nationality": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "name"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
          "name": { "type": "object", "additionalProperties": { "type": "string" } },
          "cities": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key", "name"],
              "properties": {
                "key": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
                "name": { "type": "object", "additionalProperties": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}
